{
  "entities": {
    "VerificationRequest": {
      "title": "Verification Request",
      "description": "Represents a manual verification request for an advocate's credentials.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "advocateId": { "type": "string" },
        "barCouncilNumber": { "type": "string" },
        "stateBarCouncil": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "verifierId": { "type": "string" },
        "lastModifiedBy": { "type": "string" },
        "lastModifiedAt": { "type": "string" }
      },
      "required": ["id", "advocateId", "status"]
    }
  },
  "firestore": {
    "verificationRequests/{requestId}": {
      "schema": "VerificationRequest",
      "description": "Collection of manual verification requests for advocates."
    }
  }
}
