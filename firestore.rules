rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profile, or lawyers/clients in booking context
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || resource == null);
    }
    
    // Cases require authentication, readable by client or assigned lawyer
    match /cases/{caseId} {
      allow read, write: if true;
    }
    
    // Consultations
    match /consultations/{consultationId} {
      allow read, write: if true;
    }
    
    // Documents
    match /documents/{docId} {
      allow read, write: if true;
    }
    
    // Payments
    match /payments/{paymentId} {
      allow read, write: if true;
    }
  }
}
