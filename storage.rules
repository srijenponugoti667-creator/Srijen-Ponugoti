rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /advocate-verifications/{userId}/{allPaths=**} {
      // Advocate can read/write their own files
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admin can read all
      allow read: if request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
